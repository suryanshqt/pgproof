{
  "name": "pgproof-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contract-only TypeScript types generated from the pgproof JSON Schemas",
  "type": "module",
  "scripts": {
    "generate": "node generate.mjs --write",
    "check": "node generate.mjs --check",
    "compile": "tsc --noEmit",
    "validate:fixtures": "node validate-fixtures.mjs",
    "test": "npm run check && npm run compile && npm run validate:fixtures"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
